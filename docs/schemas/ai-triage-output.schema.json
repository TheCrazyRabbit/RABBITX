{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RABBITX AI provider response 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "items": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "references": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["subjectId", "priority", "assessment", "evidenceIds", "factIds", "possibleRisk", "uncertainty", "missingValidation", "nextAction"],
      "properties": {
        "subjectId": {"type": "string", "minLength": 1, "maxLength": 80},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "assessment": {"enum": ["candidate", "informational"]},
        "evidenceIds": {"$ref": "#/$defs/references"},
        "factIds": {"$ref": "#/$defs/references"},
        "possibleRisk": {"$ref": "#/$defs/text"},
        "uncertainty": {"$ref": "#/$defs/text"},
        "missingValidation": {"$ref": "#/$defs/text"},
        "nextAction": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "method", "url", "reason"],
          "properties": {
            "kind": {"enum": ["manual_review", "baseline_get"]},
            "method": {"enum": ["NONE", "GET"]},
            "url": {"type": "string", "minLength": 1, "maxLength": 8192},
            "reason": {"$ref": "#/$defs/text"}
          },
          "oneOf": [
            {"properties": {"kind": {"const": "manual_review"}, "method": {"const": "NONE"}}},
            {"properties": {"kind": {"const": "baseline_get"}, "method": {"const": "GET"}}}
          ]
        }
      }
    }
  }
}
